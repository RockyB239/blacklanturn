<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="repository.blacklanturn" name="BlackLanturn Repository" version="1.0.5" provider-name="RockyB239">
    <extension point="xbmc.addon.repository" name="BlackLanturn Repository">
      <dir>
        <info compressed="false">https://rockyb239.github.io/blacklanturn/addons.xml</info>
        <checksum>https://rockyb239.github.io/blacklanturn/addons.xml.md5</checksum>
        <datadir zip="true">https://rockyb239.github.io/blacklanturn/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">BlackLanturn Kodi Repository</summary>
      <description lang="en_GB">Repository for the BlackLanturn Installer and related Kodi build tools.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
  <addon id="plugin.program.blacklanturninstaller" name="BlackLanturn Installer" version="1.0.5" provider-name="BlackLanturn">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="script.module.requests" />
      <import addon="script.module.six" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en">BlackLanturn Build Installer</summary>
      <description lang="en">BlackLanturn Installer provides build installation, maintenance, backups, and system management for BlackLanturn Kodi distributions.</description>
      <platform>all</platform>
      <license>GPL-3.0</license>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.png</fanart>
      </assets>
    </extension>
  </addon>
</addons>
