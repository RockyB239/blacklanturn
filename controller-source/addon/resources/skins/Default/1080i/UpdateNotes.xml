    </control>
    <control type="image">
      <left>480</left>
      <top>100</top>
      <width>960</width>
      <height>900</height>
      <texture>update-notes-panel.png</texture>
    </control>
    <control type="image">
      <left>525</left>
      <top>132</top>
      <width>65</width>
      <height>65</height>
      <texture>blacklanturn-lantern.png</texture>
      <aspectratio>keep</aspectratio>
    </control>
    <control type="label">
      <left>600</left>
      <top>140</top>
      <width>680</width>
      <height>45</height>
      <font>font25_title</font>
      <label>BlackLanturn</label>
      <textcolor>FF00D9E7</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="label">
      <left>530</left>
      <top>215</top>
      <width>850</width>
      <height>70</height>
      <font>font52_title</font>
      <label>What’s new</label>
      <textcolor>FFF2F5F7</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="label">
      <left>530</left>
      <top>290</top>
      <width>850</width>
      <height>45</height>
