      <label>$INFO[Window.Property(subtitle)]</label>
      <textcolor>FFBAC7CD</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="textbox" id="100">
      <left>530</left>
      <top>365</top>
      <width>815</width>
      <height>380</height>
      <font>font27</font>
      <textcolor>FFE0E7EB</textcolor>
      <pagecontrol>110</pagecontrol>
      <scrolltime>180</scrolltime>
    </control>
    <control type="scrollbar" id="110">
      <left>1370</left>
      <top>365</top>
      <width>20</width>
      <height>380</height>
      <orientation>vertical</orientation>
      <showonepage>true</showonepage>
      <texturesliderbackground colordiffuse="FF24343E">white.png</texturesliderbackground>
      <texturesliderbar colordiffuse="FF8CABB7">white.png</texturesliderbar>
      <texturesliderbarfocus colordiffuse="FF00D9E7">white.png</texturesliderbarfocus>
      <onleft>101</onleft>
      <onright>102</onright>
      <onup>110</onup>
      <ondown>110</ondown>
    </control>
    <control type="label">
      <left>530</left>
      <top>758</top>
      <width>860</width>
      <height>35</height>
      <font>font25_title</font>
      <label>Up / Down: scroll notes · Right: Done · Back: close</label>
      <textcolor>FFBAC7CD</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="image">
      <left>530</left>
      <top>808</top>
      <width>45</width>
      <height>45</height>
      <texture>watched-mark.png</texture>
      <aspectratio>keep</aspectratio>
    </control>
    <control type="label">
      <left>585</left>
      <top>808</top>
      <width>800</width>
      <height>45</height>
      <font>font27</font>
      <label>Your playback settings and authorizations stay saved.</label>
      <textcolor>FFD6E0E5</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="radiobutton" id="101">
      <left>530</left>
      <top>890</top>
      <width>485</width>
      <height>60</height>
      <font>font25_title</font>
      <label>Show update notices</label>
      <textcolor>FFF4F6F8</textcolor>
      <focusedcolor>FF00D9E7</focusedcolor>
      <texturefocus>focus-teal.png</texturefocus>
      <texturenofocus>nav-clear.png</texturenofocus>
      <selected>String.IsEqual(Window.Property(noticesEnabled),true)</selected>
      <onleft>102</onleft>
      <onright>103</onright>
      <onup>110</onup>
      <ondown>102</ondown>
    </control>
    <control type="button" id="103">
      <left>1040</left>
      <top>888</top>
      <width>150</width>
      <height>64</height>
      <font>font25_title</font>
      <label>Update</label>
      <textcolor>FFF2F5F7</textcolor>
      <focusedcolor>FFFFFFFF</focusedcolor>
      <texturefocus>focus-teal.png</texturefocus>
      <texturenofocus>button-dark.png</texturenofocus>
      <align>center</align>
      <aligny>center</aligny>
      <onleft>101</onleft>
      <onright>102</onright>
      <onup>110</onup>
      <ondown>101</ondown>
      <visible>String.IsEqual(Window.Property(updateAvailable),true)</visible>
    </control>
    <control type="button" id="102">
      <left>1210</left>
      <top>888</top>
      <width>180</width>
      <height>64</height>
      <font>font25_title</font>
      <label>Done</label>
      <textcolor>FFF2F5F7</textcolor>
      <focusedcolor>FFFFFFFF</focusedcolor>
      <texturefocus>focus-teal.png</texturefocus>
      <texturenofocus>button-dark.png</texturenofocus>
      <align>center</align>
      <aligny>center</aligny>
      <onleft>103</onleft>
      <onright>101</onright>
      <onup>110</onup>
      <ondown>101</ondown>
    </control>
  </controls>
</window>