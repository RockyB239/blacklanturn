<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol>110</defaultcontrol>
  <zorder>20</zorder>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
