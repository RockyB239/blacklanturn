<?xml version='1.0' encoding='utf-8'?>
<window><defaultcontrol always="true">900</defaultcontrol>
<onload condition="Player.HasVideo + String.IsEqual(Window(Home).Property(BlackLanturn.YouTube.FullscreenExit),1) + !System.HasActiveModalDialog">SetProperty(BlackLanturn.YouTube.BackRequested,1,home)</onload><onload condition="Player.HasVideo + !String.IsEqual(Window(Home).Property(BlackLanturn.YouTube.FullscreenExit),1) + !System.HasActiveModalDialog">ActivateWindow(fullscreenvideo)</onload>
<onload condition="!Player.HasVideo + !Window(Home).Property(BlackLanturn.Preview.Launched)">RunScript(script.blacklanturn.preview)</onload>
<controls>
<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture>blacklanturn/splash.png</texture><aspectratio>keep</aspectratio></control>
<control type="label"><left>590</left><top>850</top><width>740</width><height>55</height><font>font27</font><textcolor>FFB4BCC5</textcolor><label>$INFO[Window(Home).Property(BlackLanturn.Handoff.Status)]</label><align>center</align><aligny>center</aligny></control>
<control type="button" id="900"><left>610</left><top>750</top><width>700</width><height>72</height><label>Retry BlackLanturn</label><font>font27</font><texturefocus border="12">blacklanturn/player-button-focus.png</texturefocus><texturenofocus /><visible>String.IsEqual(Window(Home).Property(BlackLanturn.Recovery.Visible),true)</visible><onup>900</onup><ondown>901</ondown><onclick>RunScript(script.blacklanturn.preview)</onclick></control>
<control type="button" id="901"><left>610</left><top>844</top><width>700</width><height>72</height><label>Kodi settings</label><font>font27</font><texturefocus border="12">blacklanturn/player-button-focus.png</texturefocus><texturenofocus /><visible>String.IsEqual(Window(Home).Property(BlackLanturn.Recovery.Visible),true)</visible><onup>900</onup><ondown>902</ondown><onclick>ActivateWindow(settings)</onclick></control>
<control type="button" id="902"><left>610</left><top>938</top><width>700</width><height>72</height><label>Return to previous skin</label><font>font27</font><texturefocus border="12">blacklanturn/player-button-focus.png</texturefocus><texturenofocus /><visible>String.IsEqual(Window(Home).Property(BlackLanturn.Recovery.Visible),true)</visible><onup>901</onup><ondown>902</ondown><onclick>RunScript(script.blacklanturn.preview,recover)</onclick></control>
</controls></window>