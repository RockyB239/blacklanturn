+def _credits_prompt_due(position, total, credits, remaining, fallback):
+	"""Keep the configured end-of-file fallback when credits cannot be reached."""
+	try:
+		position, total, remaining, fallback = map(float, (position, total, remaining, fallback))
+		if not (0 < total < float('inf') and 0 < remaining < float('inf') and 0 <= position < float('inf')): return False
+	except (TypeError, ValueError, OverflowError): return False
+	try: usable = not isinstance(credits, bool) and 0 < float(credits) < total - 2
+	except (TypeError, ValueError, OverflowError): usable = False
+	return position >= float(credits) if usable else remaining <= fallback
 
 
