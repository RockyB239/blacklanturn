+class LegacyScrobblerGroup:
+    """Retain pre-provider dual-service tracking until a new selection is made."""
+    def __init__(self, scrobblers):
+        self.scrobblers = tuple(scrobblers)
+
+    @property
+    def stopped(self):
+        return all(scrobbler.stopped for scrobbler in self.scrobblers)
+
+    def update_time(self, *args):
+        for scrobbler in self.scrobblers:
+            scrobbler.update_time(*args)
+
+    def start(self, *args):
+        for scrobbler in self.scrobblers:
+            scrobbler.start(*args)
+
+    def pause(self, *args):
+        for scrobbler in self.scrobblers:
+            scrobbler.pause(*args)
+
+    def stop(self, *args):
+        for scrobbler in self.scrobblers:
+            scrobbler.stop(*args)
+
+    def sync(self, *args):
