+	def _seed_progress_length(self, meta):
+		# This item's Kodi metadata duration is already seconds. It is only a
+		# fallback for callbacks queued until after Stop discards native timing.
+		if self.scrobble_sent or self.onPlayBackStopped_ran or not self._progress_owns_playback(): return
+		if getattr(self, '_progress_length_contradicted', False): return
+		if (_progress_number(self.media_length) or 0) > 0 or not isinstance(meta, dict): return
+		value = meta.get('duration')
+		if isinstance(value, bool): return
+		length = _progress_number(value)
+		if length is not None and length > 0:
+			self.media_length = length
+			self._progress_length_fallback = True
+
+	def _accept_progress_length(self, value):
+		if isinstance(value, bool): return
+		length = _progress_number(value)
+		if length is None or length <= 0: return
+		# The first native value supersedes approximate metadata in either
+		# direction; later native reads keep the established maximum policy.
+		if getattr(self, '_progress_length_fallback', False):
+			self.media_length = length
+			current = _progress_number(self.current_time)
+			pending = getattr(self, '_progress_pending_seek', None)
+			if ((current is not None and current > length)
+					or (pending is not None and pending[0] > length)):
+				self._progress_length_contradicted = True
+		else:
+			self.media_length = max(_progress_number(self.media_length) or 0, length)
+		self._progress_length_fallback = False
+		# A contradicted snapshot stays blocked until position is accepted too.
+
+	def _sample_progress(self):
+		# Only called from existing playback/callback sampling sites. No poller.
+		current = _progress_number(self.current_time)
