+def getUmbrellaVersion(version=None):
+	# Keep upstream migrations numeric while Kodi tracks the managed package epoch.
+	if version is None:
+		version = xbmcaddon.Addon('plugin.video.umbrella').getAddonInfo('version')
+	return re_sub(r'^1:([0-9]+\.[0-9]+\.[0-9]+)\+blacklanturn\.[0-9]+$', r'\1', version)
 
 def addonVersion(addon):
 	return xbmcaddon.Addon(addon).getAddonInfo('version')
