+def _progress_number(value):
+	"""Kodi timing must be finite and nonnegative; zero is a valid seek."""
+	try:
+		value = float(value)
+		if value >= 0 and value < float('inf'): return value
+	except (TypeError, ValueError, OverflowError): pass
+	return None
 
 
