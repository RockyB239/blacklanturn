				<onright>5</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<textureradioonfocus>$VAR[BlackLanturnSettingsIcon_system]</textureradioonfocus>
				<textureradioonnofocus>$VAR[BlackLanturnSettingsIcon_system]</textureradioonnofocus>
				<textureradioofffocus>$VAR[BlackLanturnSettingsIcon_system]</textureradioofffocus>
				<textureradiooffnofocus>$VAR[BlackLanturnSettingsIcon_system]</textureradiooffnofocus>
			</control>
