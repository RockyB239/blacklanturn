				<textoffsetx>100</textoffsetx>
				<textoffsety>0</textoffsety>
				<texturefocus border="12">blacklanturn/action-panel/focus.png</texturefocus>
				<texturenofocus border="12">blacklanturn/action-panel/rest.png</texturenofocus>
				<radioposx>40</radioposx>
				<radioposy>0</radioposy>
