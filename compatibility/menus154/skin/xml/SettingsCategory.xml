				<bottom>137</bottom>
				<onleft>3</onleft>
				<onright>60</onright>
				<onup>5</onup>
				<ondown>5</ondown>
			</control>
			<control type="image">
				<left>470</left>
				<top>130</top>
				<right>0</right>
				<height>2</height>
				<texture colordiffuse="FF30434F" border="2">dialogs/separator-grey.png</texture>
			</control>
			<control type="image">
				<left>470</left>
				<bottom>135</bottom>
				<right>0</right>
