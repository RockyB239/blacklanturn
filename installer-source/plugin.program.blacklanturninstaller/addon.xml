<?xml version='1.0' encoding='utf-8'?>
<addon id="plugin.program.blacklanturninstaller" name="BlackLanturn Installer" version="1.0.52" provider-name="BlackLanturn">
    <requires>
        <import addon="xbmc.python" version="3.0.1" />
        <import addon="script.module.requests" />
        <import addon="script.module.six" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">BlackLanturn Build Installer</summary>
        <description lang="en">BlackLanturn Installer provides build installation, maintenance, backups, and system management for BlackLanturn Kodi distributions.</description>
        <news>1.0.50: Improve notification text and header selection, contain speed-test and log-upload controls, and give fullscreen text and log readers explicit viewport backgrounds.</news>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
</addon>
